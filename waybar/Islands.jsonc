{
  "layer": "bottom",
  "position": "top",
  "modules-left": [
    "group/logo",
    "clock",
    "hyprland/window",
  ],
  
  "modules-center": ["hyprland/workspaces","mpris"],
  
  "modules-right": [
    "tray",
    "custom/updates",
    "custom/clipboard",
    "backlight",
    "pulseaudio",
    "battery",
    "battery#charging" //Secondary module to allow different icons based on charging status.
  ],
  "reload_style_on_change": true,
  
   "group/logo":{
     "orientation": "horizontal",
     "drawer": {
       "transition-duration": 500
     },
   "modules": [
       "custom/logo",
       "cpu",
       "memory",
       "temperature",
       "disk",
       "custom/powerdraw",
     ]
   },

   "custom/logo": {
    "format": "󰣇",
    "on-click": "swaync-client -t",
    "tooltip": false,
  },

  "clock": {
    "format": "{:%I:%M %p %b %d}",
    "interval": 1,
    "tooltip-format": "\n<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar-weeks-pos": "right",
    "today-format": "<span color='#7645AD'><b><u>{}</u></b></span>",
    "format-calendar": "<span color='#aeaeae'><b>{}</b></span>",
    "format-calendar-weeks": "<span color='#aeaeae'><b>W{:%V}</b></span>",
    "format-calendar-weekdays": "<span color='#aeaeae'><b>{}</b></span>"
  },

  "disk": {
    "interval": 30,
    "format": " {percentage_used}%",
    "path": "/"
  },

  "memory": {
    "interval": 1,
    "format": " {percentage}%"
  },

  "cpu": {
    "interval": 1,
    "format": " {usage}%",
  },

  "temperature": {
    "format": " {temperatureC}°C",
    "format-critical": " {temperatureC}°C",
    "interval": 1,
    "critical-threshold": 80,
    "on-click": "foot btop",
  },

  "custom/powerDraw": {
    "format": "{}",
    "tooltip": false,
    "interval": 1,
    "exec": "~/.config/waybar/scripts/powerdraw.sh",
    "return-type": "json"
  },

  "hyprland/workspaces": {
    "format": "<span font='18px'>{icon}</span>",
    "format-icons": {},
    "persistent-workspaces": {
      "*": [1,2,3],
      "eDP-1": [1,2,3],
      "DP-1": [1,2,3],
      "HDMI-A-1": [4,5,6]
    }
  },

  "hyprland/window": {
    "format": "( {class} )",
    "rewrite": {
    "^\\(\\s*(.*) - Mozilla Firefox\\s*\\)$": "( 🌎 $1 )",
    "^\\(\\s*org\\.telegram\\.desktop\\s*\\)$": "( Telegram )",
    "^\\(\\s*org\\.gnome\\.Nautilus\\s*\\)$": "( nautilus )",
    "^\\(\\s*org\\.gnome\\.(.+?)\\s*\\)$": "( $1 )",
    "^\\(\\s*.*\\.([^\\s)]+)\\s*\\)$": "( $1 )",
    "^\\(\\s*(.*) - zsh\\s*\\)$": "( $1 )"
    }
  },

  "tray": {
    "icon-size": 14,
    "spacing": 10
  },

  "custom/updates": {
    "format": "{}",
    "intemrval": 60,
    "exec": "bash ~/.config/waybar/scripts/myUpdates.sh",
    "return-type": "json",
    "exec-if": "exit 0",
  },

  "custom/clipboard": {
    // "exec": "echo '󰅍'",
    "interval": 5,
    "tooltip": true,
    // "tooltip-format": "{output}",
    // "exec-tooltip": "sh -c cliphist list | head -n 5",
    "on-click": "sh -c 'cliphist list | rofi -dmenu | cliphist decode | wl-copy'"
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{percent}% {icon}",
    "format-icons": [
      "",
      "󰪞",
      "󰪟",
      "󰪠",
      "󰪡",
      "󰪢",
      "󰪣",
      "󰪤",
      "󰪥",
    ],
    "on-scroll-down": "light -U 5",
    "on-scroll-up": "light -A 5",
    "min-brightness": 5,
    "smooth-scrolling-threshold": 1
  },

  "idle_inhibitor": {
    "format": "<span font='12'>{icon}</span>",
    "format-icons": {
      "activated": "󰾪",
      "deactivated": "󰅶"
    }
  },

  "custom/colorpicker": {
    "format": "{}",
    "return-type": "json",
    "interval": "once",
    "exec": "~/.config/waybar/scripts/colorpicker.sh -j",
    "on-click": "sleep 1 && ~/.config/waybar/scripts/colorpicker.sh",
  },

  "bluetooth": {
    "format-on": "󰂰",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂴",
    "format-connected-battery": "{device_battery_percentage}% 󰂴",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "rofi-bluetooth",
  },

  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon}",
    "format-muted": "",
    "tooltip-format": "{volume}% {icon}",
    "format-icons": {
      "headphones": "",
      "bluetooth": "󰥰",
      "handsfree": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        ""
      ]
    },
    "scroll-step": 5,
    "justify": "center",
    "on-click": "kitty -e bluetuith",
    "tooltip-format": "Left click for bluetooth",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
    "max-volume": 100
  },

  "pulseaudio#mic": {
    "format": "{format_source}",
    "format-source": "",
    "format-source-muted": "",
    "tooltip-format": "{volume}% {format_source} ",
    "on-click": "pactl set-source-mute 0 toggle",
    "on-scroll-down": "pactl set-source-volume 0 -1%",
    "on-scroll-up": "pactl set-source-volume 0 +1%"
  },

  "group/audio": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false
    },
    "modules": [
      "pulseaudio",
      "pulseaudio#mic",
      ]
  },

  "pulseaudio/slider": {
    "min": 0,
    "max": 140,
    "orientation": "horizontal"
  },

  "custom/hotspot": {
    "format": "{icon}",
    "interval": 1,
    "tooltip": true,
    "tooltip-format": "Right click to stop",
    "return-type": "json",
    "format-icons": {
      "active": "󱜠",
      "notactive": "󱜡"
    },
    "exec": "waybar-hotspot -a watch",
    "on-click": "waybar-hotspot",
    "on-click-right": "waybar-hotspot -a stop",
  },

  "network": {
    "format-wifi": " ",
    "format-ethernet": "󰈀",
    "format-disconnected": "󱐅",
    "tooltip-format": "{ipaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)  | {ipaddr}",
    "tooltip-format-ethernet": "{ifname} 🖧 | {ipaddr}",
    "tooltip-format-ethernet": "{bandwidthTotalBytes}",
    "on-click": "nm-connection-editor",
  },

  "network#speed": {
    "format": "{bandwidthDownBits}",
    "interval": 1,
    "tooltip-format": "{ipaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)   \n{ipaddr} | {frequency} MHz{icon} ",
    "tooltip-format-ethernet": "{ifname} 󰈀 \n{ipaddr} | {frequency} MHz{icon} ",
    "tooltip-format-disconnected": "Not Connected to any type of Network",
    "tooltip": true,
    "on-click": "pgrep -x rofi &>/dev/null && notify-send rofi || networkmanager_dmenu"
  },

  "group/networking": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false
    },
    "modules": [
      "network",
      "network#speed"
    ]
  },

  "battery": {
    "interval": 1,
    "states": {
      "good": 95,
      "warning": 15,
      "critical": 5
    },
    "tooltip": true,
    "format": "{capacity}% {icon}",
    "format-time": "{H}h {M}min remaining",
    "tooltip-format": "{time}",
    "format-charging": "",
    "format-plugged": "",
    "format-icons": ["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰂄"],
    "on-click": "~/.config/waybar/scripts/powerdraw.sh"
  },

  "battery#charging": {
    "interval": 1,
    "states": {
      "good": 95,
      "warning": 15,
      "critical": 5
    },
    "tooltip": true,
    "format": "",
    "format-time": "{H}h {M}min until full",
    "tooltip-format": "{time}",
    "format-charging": "{capacity}% {icon}",
    "format-plugged": "{capacity}% {icon}",
    "format-icons": ["󰢟","󰢜","󰂆","󰂇","󰂈","󰢝","󰂉","󰢞","󰂊","󰂋","󰂄"],
    "on-click": "~/.config/waybar/scripts/powerdraw.sh"
  },  

  "custom/weather": {
   "exec": "/home/vinescent/.config/waybar/scripts/weather.sh",
   "interval": 600,
   "return-type": "json",
   "format": "{text}",
   "tooltip": true,
   "max-length": 0
},

  "mpris": {
  "format": "{title} - {artist}",
  "title-len": 20,
  "max-length": 30,
  "interval": 1,
  "on-click": "playerctl play-pause -p spotify",
  "on-scroll-up": "playerctl previous -p spotify",
  "on-scroll-down": "playerctl next -p spotify"
},
}
